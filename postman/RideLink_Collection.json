{
  "info": {
    "_postman_id": "ridelink-microservices-col",
    "name": "RideLink Microservices API",
    "description": "Postman collection for RideLink Microservices (Account Service & Fare & Payment Service)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Account Service (Port 8081)",
      "item": [
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+94771234567\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/api/auth/register/passenger",
              "host": ["{{account_url}}"],
              "path": ["api", "auth", "register", "passenger"]
            }
          }
        },
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "    pm.environment.set(\"accountId\", jsonData.accountId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/api/auth/login",
              "host": ["{{account_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Own Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{account_url}}/api/accounts/me",
              "host": ["{{account_url}}"],
              "path": ["api", "accounts", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Fare & Payment Service (Port 8084)",
      "item": [
        {
          "name": "Calculate Fare Estimate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"distanceKm\": 12.5,\n  \"durationMinutes\": 25\n}"
            },
            "url": {
              "raw": "{{fare_url}}/api/fares/estimate",
              "host": ["{{fare_url}}"],
              "path": ["api", "fares", "estimate"]
            }
          }
        },
        {
          "name": "Compute Final Fare",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.fareId) {",
                  "    pm.environment.set(\"fareId\", jsonData.fareId);",
                  "    pm.environment.set(\"fareAmount\", jsonData.totalAmount);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\",\n  \"passengerId\": \"{{accountId}}\",\n  \"driverId\": \"b1eebc99-9c0b-4ef8-bb6d-6bb9bd380b22\",\n  \"distanceKm\": 12.5,\n  \"durationMinutes\": 25\n}"
            },
            "url": {
              "raw": "{{fare_url}}/api/fares/final",
              "host": ["{{fare_url}}"],
              "path": ["api", "fares", "final"]
            }
          }
        },
        {
          "name": "Process Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.paymentId) {",
                  "    pm.environment.set(\"paymentId\", jsonData.paymentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fareId\": \"{{fareId}}\",\n  \"paymentMethod\": \"CARD\",\n  \"amount\": {{fareAmount}}\n}"
            },
            "url": {
              "raw": "{{fare_url}}/api/payments/process",
              "host": ["{{fare_url}}"],
              "path": ["api", "payments", "process"]
            }
          }
        },
        {
          "name": "Get Payment Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{fare_url}}/api/payments/{{paymentId}}",
              "host": ["{{fare_url}}"],
              "path": ["api", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Get Receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{fare_url}}/api/receipts/{{paymentId}}",
              "host": ["{{fare_url}}"],
              "path": ["api", "receipts", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{fare_url}}/api/payments/{{paymentId}}/refund",
              "host": ["{{fare_url}}"],
              "path": ["api", "payments", "{{paymentId}}", "refund"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Negative Test Cases",
      "item": [
        {
          "name": "Validation Error - Negative Distance (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"distanceKm\": -5.0,\n  \"durationMinutes\": 10\n}"
            },
            "url": {
              "raw": "{{fare_url}}/api/fares/estimate",
              "host": ["{{fare_url}}"],
              "path": ["api", "fares", "estimate"]
            }
          }
        },
        {
          "name": "Auth Error - Missing JWT (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{account_url}}/api/accounts/me",
              "host": ["{{account_url}}"],
              "path": ["api", "accounts", "me"]
            }
          }
        }
      ]
    }
  ]
}
