# RideLink – Environment Variables Reference
#
# DO NOT commit real secrets. Copy the PowerShell commands below into your terminal
# BEFORE starting any service.
#
# ─────────────────────────────────────────────
# Required: Set in EVERY PowerShell session before starting services
# ─────────────────────────────────────────────

# JWT signing secret – must be Base64-encoded, min 32 bytes when decoded.
# Generate a real one with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
$env:JWT_SECRET = "REPLACE_WITH_A_REAL_BASE64_SECRET_AT_LEAST_32_BYTES_LONG_HERE_FOR_PRODUCTION"

# ─────────────────────────────────────────────
# Required: Ride Service interservice URLs
# (defaults shown; only override if you change ports)
# ─────────────────────────────────────────────
$env:DRIVER_SERVICE_URL = "http://localhost:8082"
$env:FARE_SERVICE_URL   = "http://localhost:8084"

# ─────────────────────────────────────────────
# Service ports (Spring Boot reads these; defaults match assignment spec)
# ─────────────────────────────────────────────
# Account Service   -> 8081  (default in application.properties)
# Driver Service    -> 8082
# Ride Service      -> 8083
# Fare Service      -> 8084

# ─────────────────────────────────────────────
# Dev-only placeholders already in application.properties
# (used when the env var is not set – SAFE FOR LOCAL TESTING ONLY)
# ─────────────────────────────────────────────
# jwt.secret = ${JWT_SECRET:bXktc3VwZXItc2VjcmV0LWtleS10aGF0LWlzLWxvbmctZW5vdWdoLWZvci1IUzI1Ng==}
#
# The placeholder above decodes to:
#   "my-super-secret-key-that-is-long-enough-for-HS256"
# NEVER use this in a production or publicly accessible environment.
